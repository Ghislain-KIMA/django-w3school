# ==============================================================================
# CONFIGURATION DJANGO DE TEST / EXEMPLE
# Copiez ce fichier en '.env' et remplissez les vraies valeurs.
# ==============================================================================

# Clé de sécurité Django (Générer une clé unique pour la production)
SECRET_KEY=django-insecure-example-key-change-this-in-production

# Mode débogage (True en local, False en production)
DEBUG=True

# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=127.0.0.1,localhost

# Origines de confiance pour CSRF (séparées par des virgules)
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Base de données (Format: postgres://user:password@host:port/dbname)
# Exemple SQLite local : sqlite:///db.sqlite3
# Exemple PostgreSQL  : postgres://postgres:postgres@localhost:5432/my_database
DATABASE_URL=sqlite:///db.sqlite3
